import React, { useState, useMemo, useCallback } from "react";
import {
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  Cell,
} from "recharts";
import {
  Wifi,
  Cpu,
  Timer,
  Zap,
  Download,
  RotateCcw,
  CheckCircle2,
  XCircle,
  AlertTriangle,
  Radio,
} from "lucide-react";
 
/**
 * ─────────────────────────────────────────────────────────────────────────
 * 5G NETWORK SLICING — CONCEPT PRIMER (for the project report / viva)
 * ─────────────────────────────────────────────────────────────────────────
 * Network slicing lets a single physical 5G infrastructure (radio, transport,
 * and core network) be partitioned into multiple independent *logical*
 * networks — "slices" — each tuned to a different service's needs. This is
 * done via Software Defined Networking (SDN) and Network Function
 * Virtualization (NFV): the same base stations and switches run virtualized
 * network functions, and an orchestrator carves out bandwidth, compute
 * (for the virtualized functions), and latency guarantees per slice.
 *
 * The 3GPP defines three canonical service categories that this simulator
 * models as slice types:
 *   • eMBB  (Enhanced Mobile Broadband)          — throughput-first
 *   • URLLC (Ultra-Reliable Low-Latency Comms)   — latency/reliability-first
 *   • mMTC  (Massive Machine-Type Comms)         — density-first, tolerant
 *
 * A Service Level Agreement (SLA) per slice defines the guarantees the
 * network must meet. In this simulator, an SLA "breach" occurs when either:
 *   1) simulated traffic demand exceeds the bandwidth allocated to the slice
 *      (congestion), or
 *   2) simulated latency exceeds the slice's latency budget (jitter beyond
 *      what the reserved scheduling priority can absorb).
 *
 * Note on "latency budget" as a pooled resource: in a real deployment,
 * latency isn't literally drawn from a shared numeric pool the way
 * bandwidth (Hz/Mbps) or compute (vCPU) is — it's an outcome of scheduling
 * priority, transport hops, and RAN configuration. For teaching purposes,
 * this simulator simplifies it into a shared 50ms "scheduling budget" pool
 * so learners can see the fundamental trade-off: giving one slice tighter
 * latency guarantees leaves less scheduling headroom for the others.
 * ─────────────────────────────────────────────────────────────────────────
 */
 
// ---------------------------------------------------------------------------
// STATIC CONFIG — the physical resource pool and the three slice archetypes.
// In a real orchestrator (e.g. a 5G Core's NSSMF) these would come from
// infrastructure inventory and 3GPP-standard slice/service profiles.
// ---------------------------------------------------------------------------
 
const POOL_CAPACITY = { bandwidth: 1000, compute: 100, latency: 50 };
 
const SLICE_CONFIG = {
  embb: {
    key: "embb",
    name: "eMBB",
    fullName: "Enhanced Mobile Broadband",
    useCase: "Video streaming, AR/VR, high-speed browsing",
    principle: "Prioritizes throughput. Tolerant of latency jitter.",
    color: "blue",
    latencyJitterMs: 9, // wider natural jitter — budget can be loose
  },
  urllc: {
    key: "urllc",
    name: "URLLC",
    fullName: "Ultra-Reliable Low-Latency Communications",
    useCase: "Autonomous vehicles, remote surgery, industrial control",
    principle: "Prioritizes deterministic latency & reliability over throughput.",
    color: "red",
    latencyJitterMs: 1.4, // tiny jitter tolerance — needs a tight, guaranteed budget
  },
  mmtc: {
    key: "mmtc",
    name: "mMTC",
    fullName: "Massive Machine-Type Communications",
    useCase: "IoT sensors, smart meters, asset tracking",
    principle: "Prioritizes connection density. Highly latency-tolerant.",
    color: "emerald",
    latencyJitterMs: 22, // very tolerant — sensors don't mind waiting
  },
};
 
const SLICE_ORDER = ["embb", "urllc", "mmtc"];
 
// Sensible starting allocation: leaves visible headroom in every pool so a
// learner can immediately try pushing a slider into the "blocked" state.
const DEFAULT_ALLOCATIONS = {
  embb: { bandwidth: 500, compute: 40, latency: 15 },
  urllc: { bandwidth: 100, compute: 30, latency: 1 },
  mmtc: { bandwidth: 150, compute: 15, latency: 30 },
};
 
// Tailwind class lookups. Kept static (not template-interpolated with
// arbitrary values) so every class the UI needs is a real, predefined
// utility class.
const COLOR_CLASSES = {
  blue: {
    text: "text-blue-400",
    bg: "bg-blue-500",
    bgSoft: "bg-blue-500/10",
    border: "border-blue-500",
    ring: "ring-blue-500",
    fill: "#60a5fa",
  },
  red: {
    text: "text-red-400",
    bg: "bg-red-500",
    bgSoft: "bg-red-500/10",
    border: "border-red-500",
    ring: "ring-red-500",
    fill: "#f87171",
  },
  emerald: {
    text: "text-emerald-400",
    bg: "bg-emerald-500",
    bgSoft: "bg-emerald-500/10",
    border: "border-emerald-500",
    ring: "ring-emerald-500",
    fill: "#34d399",
  },
};
 
const clamp = (val, min, max) => Math.min(Math.max(val, min), max);
 
// ---------------------------------------------------------------------------
// CUSTOM HOOK — encapsulates the "simulate traffic + check SLA" logic.
// Kept separate from rendering so the simulation rules (the interesting
// domain logic for a viva) are easy to point to in one place.
// ---------------------------------------------------------------------------
function useSliceSimulation() {
  const [results, setResults] = useState(null);
  const [runCount, setRunCount] = useState(0);
 
  const simulate = useCallback((allocations, activeKeys, congestionMode) => {
    // Congestion mode scales up demand generation to stress-test every
    // active slice simultaneously — useful for demonstrating how an
    // under-provisioned slice fails first under load.
    const stress = congestionMode ? 1.7 : 1.0;
 
    const next = {};
    activeKeys.forEach((key) => {
      const alloc = allocations[key];
      const cfg = SLICE_CONFIG[key];
 
      // Bandwidth demand: a random fraction of the allocation, occasionally
      // spiking past 100% to simulate bursty real-world traffic.
      const demandFactor = (0.35 + Math.random() * 1.0) * stress;
      const bandwidthDemand = alloc.bandwidth * demandFactor;
      const bandwidthUtilPct =
        alloc.bandwidth > 0 ? (bandwidthDemand / alloc.bandwidth) * 100 : 0;
 
      // Experienced latency: allocated budget plus random jitter. A slice
      // with a tighter latencyJitterMs (like URLLC) swings less in absolute
      // terms but has far less budget to absorb it.
      const jitter = (Math.random() - 0.35) * cfg.latencyJitterMs * stress;
      const experiencedLatency = Math.max(0.1, alloc.latency + jitter);
 
      const bandwidthOk = bandwidthDemand <= alloc.bandwidth;
      const latencyOk = experiencedLatency <= alloc.latency;
 
      next[key] = {
        bandwidthDemand,
        bandwidthUtilPct,
        experiencedLatency,
        bandwidthOk,
        latencyOk,
        pass: bandwidthOk && latencyOk,
      };
    });
 
    setResults(next);
    setRunCount((c) => c + 1);
    return next;
  }, []);
 
  const reset = useCallback(() => {
    setResults(null);
    setRunCount(0);
  }, []);
 
  return { results, runCount, simulate, reset };
}
 
